pkgname=termocode-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Terminal IDE that feels like VSCode, powered by an embedded Neovim"
arch=('x86_64' 'aarch64')
url="https://github.com/@REPO@"
license=('MIT')
depends=('neovim')
optdepends=('ripgrep: fast workspace search (pure-Go fallback otherwise)'
            'git: Source Control sidebar'
            'ttf-jetbrains-mono-nerd: icons in the explorer and tabs')
provides=('termocode')
conflicts=('termocode')
source=("LICENSE::https://raw.githubusercontent.com/@REPO@/v${pkgver}/LICENSE")
source_x86_64=("termocode-v${pkgver}-linux-amd64.tar.gz::https://github.com/@REPO@/releases/download/v${pkgver}/termocode-v${pkgver}-linux-amd64.tar.gz")
source_aarch64=("termocode-v${pkgver}-linux-arm64.tar.gz::https://github.com/@REPO@/releases/download/v${pkgver}/termocode-v${pkgver}-linux-arm64.tar.gz")
sha256sums=('SKIP')
sha256sums_x86_64=('@SHA_LINUX_AMD64@')
sha256sums_aarch64=('@SHA_LINUX_ARM64@')

package() {
  local _arch
  case "$CARCH" in
    x86_64) _arch=amd64 ;;
    aarch64) _arch=arm64 ;;
  esac
  install -Dm755 "termocode-v${pkgver}-linux-${_arch}/termocode" "$pkgdir/usr/bin/termocode"
  install -Dm644 "termocode-v${pkgver}-linux-${_arch}/README.md" "$pkgdir/usr/share/doc/termocode/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
