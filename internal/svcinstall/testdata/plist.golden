<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- termocode-service: managed by termocode, remove with `termocode service uninstall` -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.termocode.25fbae5b</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/termocode</string>
		<string>__session-server</string>
		<string>/Users/u/a&amp;b</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
</dict>
</plist>
